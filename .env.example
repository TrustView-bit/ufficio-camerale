# =============================================================================
# Ufficio Camerale — variabili d'ambiente
# Copia questo file in .env.local e compila i valori.
# Tutte le variabili sono validate all'avvio con zod (fail fast).
# Nessuna di queste chiavi deve mai finire nel bundle client.
# =============================================================================

# --- Generale ----------------------------------------------------------------
# URL pubblico del sito, usato per canonical, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (step 4) -------------------------------------------------------
# Neon o Vercel Postgres. Stringa di connessione con SSL.
DATABASE_URL=""

# --- Cache e rate limiting (step 4 / 7) --------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Provider dati camerali (step 4) -----------------------------------------
# Provider primario: openapi.it. Adapter Cerved/InfoCamere/Atoka predisposti.
COMPANY_PROVIDER="mock"          # mock | openapi
OPENAPI_IT_TOKEN=""
# Costo reale di una chiamata, dal listino del fornitore. Lasciato a 0 finché
# non è noto: una cifra inventata nella colonna dei costi produce un totale
# che sembra una spesa e non lo è.
OPENAPI_COSTO_PER_CHIAMATA="0"
# Giorni dopo i quali un record in cache viene considerato stantio
# e si richiama il provider a pagamento.
REFRESH_AFTER_DAYS="30"

# --- Descrizioni generate ----------------------------------------------------
# Senza chiave le schede restano come sono: la generazione non parte e non
# costa nulla. Con la chiave, la sintesi viene scritta alla prima visita di
# una scheda — mai in blocco su tutto l'archivio — e poi conservata.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
